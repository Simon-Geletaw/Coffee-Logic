{
  "name": "coffee-logic",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "scripts": {
    "postinstall": "pnpm -C apps/api exec prisma generate --schema ../../prisma/schema.prisma",
    "build": "pnpm -C apps/api build",
    "start:prod": "pnpm -C apps/api start:prod",
    "migrate:deploy": "pnpm -C apps/api exec prisma migrate deploy --schema ../../prisma/schema.prisma",
    "dev:web": "pnpm -C apps/web dev",
    "dev:api": "pnpm -C apps/api start:dev",
    "db:generate": "pnpm -C apps/api exec prisma generate --schema ../../prisma/schema.prisma",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "pnpm -C apps/api test && pnpm -C apps/web test",
    "test:e2e": "pnpm -C apps/api test:e2e"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "prisma": "6.19.3"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcrypt": "^6.0.0",
    "eslint": "^9.39.5",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3"
  }
}
