{
  "name": "coffee-logic",
  "private": true,
  "scripts": {
    "dev:web": "pnpm -C apps/web dev",
    "dev:api": "pnpm -C apps/api start:dev",
    "lint": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "pnpm -C apps/api test && pnpm -C apps/web test",
    "test:e2e": "pnpm -C apps/api test:e2e"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/mocha": "^10.0.10",
    "dot": "^1.1.3",
    "env": "^0.0.2",
    "prisma": "^6.19.3"
  },
  "dependencies": {
    "@nestjs/core": "^11.0.1",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "install": "^0.13.0",
    "next": "16.1.6",
    "pnpm": "^11.5.1",
    "prettier": "^3.8.1"
  }
}
