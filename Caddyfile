# Automatic TLS via Let's Encrypt. DOMAIN comes from .env.prod.
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy web:3000
}

api.{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}
	# Webhooks and the storefront both hit this; body size stays small.
	request_body {
		max_size 1MB
	}
	reverse_proxy api:3001
}
