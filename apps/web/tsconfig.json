    ".next-web-dev-29828/dev/types/**/*.ts",
    ".next-web-dev-14556/types/**/*.ts",
    ".next-web-dev-14556/dev/types/**/*.ts",
    ".next-web-dev-17568/types/**/*.ts",
    ".next-web-dev-17568/dev/types/**/*.ts",
    ".next-web-dev-23176/types/**/*.ts",
    ".next-web-dev-23176/dev/types/**/*.ts",
    ".next-web-dev-18936/types/**/*.ts",
    ".next-web-dev-18936/dev/types/**/*.ts",
    ".next-web-dev-4900/types/**/*.ts",
    ".next-web-dev-4900/dev/types/**/*.ts",
    ".next-web-dev-19740/types/**/*.ts",
    ".next-web-dev-19740/dev/types/**/*.ts",
    ".next-web-dev-16200/types/**/*.ts",
    ".next-web-dev-16200/dev/types/**/*.ts",
    ".next-web-dev-416/types/**/*.ts",
    ".next-web-dev-416/dev/types/**/*.ts",
