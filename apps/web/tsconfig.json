{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-web/types/**/*.ts",
    ".next-web/dev/types/**/*.ts",
    ".next-web-dev-*/types/**/*.ts",
    ".next-web-dev-*/dev/types/**/*.ts",
    "**/*.mts",
    ".next-web-dev-22756/types/**/*.ts",
    ".next-web-dev-22756/dev/types/**/*.ts",
    ".next-web-dev-6956/types/**/*.ts",
    ".next-web-dev-6956/dev/types/**/*.ts",
    ".next-web-dev-11660/types/**/*.ts",
    ".next-web-dev-11660/dev/types/**/*.ts",
    ".next-web-dev-18404/types/**/*.ts",
    ".next-web-dev-18404/dev/types/**/*.ts",
    ".next-web-dev-23704/types/**/*.ts",
    ".next-web-dev-23704/dev/types/**/*.ts",
    ".next-web-dev-24180/types/**/*.ts",
    ".next-web-dev-24180/dev/types/**/*.ts",
    ".next-web-dev-16296/types/**/*.ts",
    ".next-web-dev-16296/dev/types/**/*.ts",
    ".next-web-dev-37772/types/**/*.ts",
    ".next-web-dev-37772/dev/types/**/*.ts",
    ".next-web-dev-25148/types/**/*.ts",
    ".next-web-dev-25148/dev/types/**/*.ts",
    ".next-web-dev-24564/types/**/*.ts",
    ".next-web-dev-24564/dev/types/**/*.ts",
    ".next-web-dev-15080/types/**/*.ts",
    ".next-web-dev-15080/dev/types/**/*.ts",
    ".next-web-dev-9008/types/**/*.ts",
    ".next-web-dev-9008/dev/types/**/*.ts",
    ".next-web-dev-21820/types/**/*.ts",
    ".next-web-dev-21820/dev/types/**/*.ts",
    ".next-web-dev-100/types/**/*.ts",
    ".next-web-dev-100/dev/types/**/*.ts",
    ".next-web-dev-40580/types/**/*.ts",
    ".next-web-dev-40580/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
