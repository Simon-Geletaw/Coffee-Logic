// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  viewer
  operator
  manager
  admin
}

enum OrderStatus {
  cart
  pending
  paid
  failed
  refunded
}

enum SubscriptionStatus {
  active
  paused
  canceled
}

enum WebhookStatus {
  success
  fail
}

enum Currency {
  ETB
  USD
}

model User {
  id             String         @id @default(uuid())
  firstName      String
  lastName       String
  email          String         @unique
  phoneNumber    String?        @unique
  passwordHash   String
  role           UserRole
  defaultAddress String?
  isActive       Boolean        @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  orders         Order[]
  subscriptions  Subscription[]
  auditEvents    AuditEvent[]   @relation("AuditActor")
}

model Product {
  id             String   @id @default(uuid())
  name           String
  description    String?
  roastLevel     String
  grind          String
  origin         String
  process        String
  caffeine       String
  imageUrl       String?
  sensoryProfile Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  variants ProductVariant[]
  batches  Batch[]
}

model ProductVariant {
  id          String   @id @default(uuid())
  productId   String
  weightGrams Int
  priceCents  Int
  currency    Currency @default(ETB)
  sku         String?
  isActive    Boolean  @default(true)

  product           Product            @relation(fields: [productId], references: [id])
  orderItems        OrderItem[]
  subscriptionItems SubscriptionItem[]
}

model Batch {
  id        String    @id @default(uuid())
  productId String
  batchCode String
  roastDate DateTime
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  // Soft-delete: when false, the batch is considered deleted but data is preserved
  isActive  Boolean   @default(true)

  product   Product    @relation(fields: [productId], references: [id])
  inventory Inventory?
}

model Inventory {
  id        String   @id @default(uuid())
  batchId   String   @unique
  onHand    Int
  reserved  Int
  available Int
  updatedAt DateTime @updatedAt
  status    Boolean  @default(true)

  batch        Batch              @relation(fields: [batchId], references: [id])
  reservations StockReservation[]
}

model Order {
  id        String      @id @default(uuid())
  userId    String?
  cartToken String?     @unique
  status    OrderStatus

  // Money is decomposed so the summary, the provider charge and the tests
  // all agree on the same numbers. Minor units (santim / cents).
  subtotalCents    Int      @default(0)
  shippingCents    Int      @default(0)
  totalCents       Int      @default(0)
  totalWeightGrams Int      @default(0)
  currency         Currency @default(ETB)

  // Proof of payment. One provider session settles at most one order.
  paymentProvider  String?
  paymentIntentId  String?   @unique // Stripe session id or Chapa tx_ref
  paymentExpiresAt DateTime?
  paidAt           DateTime?
  failureReason    String?

  contactName     String?
  contactEmail    String?
  contactPhone    String?
  shippingAddress String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User?              @relation(fields: [userId], references: [id])
  items        OrderItem[]
  reservations StockReservation[]
}

model OrderItem {
  id               String @id @default(uuid())
  orderId          String
  productVariantId String
  quantity         Int
  unitPriceCents   Int
  lineTotalCents   Int

  order          Order          @relation(fields: [orderId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  reservation    StockReservation?
}

// Units held for a pending order, allocated from one batch's inventory.
// Created when a payment session opens; deleted when the order is paid
// (units leave onHand) or fails/expires (units return to available).
// Persisting the allocation is what makes release and commit exact.
model StockReservation {
  id          String   @id @default(uuid())
  orderId     String
  orderItemId String   @unique
  inventoryId String
  quantity    Int
  createdAt   DateTime @default(now())

  order     Order     @relation(fields: [orderId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  inventory Inventory @relation(fields: [inventoryId], references: [id])

  @@index([orderId])
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String
  stripeSubscriptionId String             @unique
  status               SubscriptionStatus
  cadenceDays          Int
  nextChargeAt         DateTime
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user  User               @relation(fields: [userId], references: [id])
  items SubscriptionItem[]
}

model SubscriptionItem {
  id               String @id @default(uuid())
  subscriptionId   String
  productVariantId String
  quantity         Int
  unitPriceCents   Int

  subscription   Subscription   @relation(fields: [subscriptionId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
}

model WebhookLog {
  id           String        @id @default(uuid())
  provider     String
  eventId      String        @unique
  eventType    String
  payload      Json
  status       WebhookStatus
  errorMessage String?
  processedAt  DateTime?
}

model AuditEvent {
  id          String   @id @default(uuid())
  actorUserId String
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorUserId], references: [id])
}

// Weight-tier shipping. A cart of W grams pays the cheapest active tier
// whose maxGrams >= W in its currency. Data, not code: the admin edits it.
model ShippingRate {
  id       String   @id @default(uuid())
  currency Currency
  maxGrams Int
  cents    Int
  label    String
  isActive Boolean  @default(true)

  @@unique([currency, maxGrams])
}
