# ── Core ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://coffee:coffee@localhost:7000/coffee_logic
# 32 random bytes as hex:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── URLs ─────────────────────────────────────────────────────────────
WEB_ORIGIN=http://localhost:3000
# Local: your ngrok URL, e.g. https://abc123.ngrok-free.app (Chapa needs it)
API_PUBLIC_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# ── Redis (docker compose exposes 6379) ──────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Stripe (test mode) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
# From:  stripe listen --forward-to localhost:3001/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Chapa (test mode) ────────────────────────────────────────────────
CHAPA_SECRET_KEY=CHASECK_TEST-...
# Set in the Chapa dashboard under Settings → Webhooks; any long random string
CHAPA_WEBHOOK_SECRET=

# ── Checkout ─────────────────────────────────────────────────────────
CHECKOUT_HOLD_MINUTES=30
